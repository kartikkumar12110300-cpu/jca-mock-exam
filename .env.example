# ─── Local development ────────────────────────────────────────────────────────
# Where the local SQLite file lives. Defaults to ./data/app.db
# DATA_DIR=./data

# PORT=3000

# ─── Hosted database (Turso) ─────────────────────────────────────────────────
# Set both in production. When TURSO_DATABASE_URL is present the app ignores
# DATA_DIR and talks to Turso instead. Never commit real values.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ─── Accounts ────────────────────────────────────────────────────────────────
# Password for the seeded `admin` account. Only read on the first boot, when the
# accounts are created. If omitted, the admin password is `admin`.
# ADMIN_PASSWORD=

# ─── AI question generation (not implemented yet) ─────────────────────────────
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=
